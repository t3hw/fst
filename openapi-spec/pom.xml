      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>Import-Server-Swagger</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <phase>generate-sources</phase>
            <configuration>
              <inputSpec>${project.basedir}${yaml-location-service}</inputSpec>
              <output>${project.build.directory}/generated-sources</output>
              <!-- <output>${project.basedir}</output> -->
              <generatorName>spring</generatorName>
              <apiPackage>dev.t3hw.fstest.server</apiPackage>
              <modelPackage>dev.t3hw.fstest.model</modelPackage>
              <supportingFilesToGenerate>ApiUtil.java</supportingFilesToGenerate>
              <configOptions>
                <hideGenerationTimestamp>true</hideGenerationTimestamp>
                <delegatePattern>true</delegatePattern>
                <documentationProvider>springdoc</documentationProvider>
                <additionalModelTypeAnnotations>
@com.fasterxml.jackson.annotation.JsonInclude(com.fasterxml.jackson.annotation.JsonInclude.Include.NON_NULL)
@Valid
                </additionalModelTypeAnnotations>
                <disallowAdditionalPropertiesIfNotPresent>true</disallowAdditionalPropertiesIfNotPresent>
                <openApiNullable>false</openApiNullable>
                <useOptional>true</useOptional>
                <useJakartaEe>true</useJakartaEe>
                <useSpringBoot3>true</useSpringBoot3>
                <generateApiTests>true</generateApiTests>
                <generateModelTests>true</generateModelTests>
              </configOptions>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>